# ==============================================================================
# CodeAtlas Environment Configuration Example
# Copy this file to .env.local and update the values as needed:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub Configuration (Optional)
# ------------------------------------------------------------------------------
# GITHUB_TOKEN:
# Personal Access Token used to fetch public repositories with higher rate limits
# (5,000 requests/hr vs 60 requests/hr unauthenticated), and to inspect private repos.
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitHub OAuth Application (Optional, enables 1-click GitHub login):
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ------------------------------------------------------------------------------
# AI & LLM Providers (Optional)
# If omitted, CodeAtlas falls back to local AST-based deterministic synthesis.
# ------------------------------------------------------------------------------
# OpenRouter (Recommended: gives access to Gemini, Nemotron, Claude, etc.):
# Obtain a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FREE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Direct Provider Keys (Alternative to OpenRouter):
# Google Gemini: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Server & Database Settings
# ------------------------------------------------------------------------------
PORT=3000
DATABASE_URL=
